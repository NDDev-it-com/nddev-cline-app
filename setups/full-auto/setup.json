{
  "schema_version": 1,
  "id": "full-auto",
  "description": "Autonomous Cline CLI setup: auto-approval is enabled while destructive/auth/update commands remain denied by command policy.",
  "managed_files": [
    "data/settings/global-settings.json",
    "data/settings/cline_mcp_settings.json",
    "rules/nddev-managed.md"
  ],
  "builder_projection": "native-skills-agents-plugin-user-files",
  "builder_default_on": true,
  "launch_args": ["--auto-approve", "true"]
}
