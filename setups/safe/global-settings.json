{
  "autoApprove": false,
  "browser": {
    "enabled": false
  },
  "checkpoint": {
    "enabled": false
  },
  "cline": {
    "autoUpdate": false,
    "dataDir": "${CLINE_DATA_DIR}",
    "plugins": {
      "enabled": ["nddev-builder"]
    }
  },
  "commandExecution": {
    "autoApprove": false
  },
  "commandPermissions": {
    "allow": [],
    "allowRedirects": false,
    "deny": ["*"]
  },
  "dangerousActions": {
    "allowed": false
  },
  "mcp": {
    "servers": {}
  },
  "mode": "plan",
  "network": {
    "allowRemoteMcp": false
  },
  "notifications": {
    "enabled": false
  },
  "privacy": {
    "shareTelemetry": false
  },
  "sandbox": {
    "enabled": true,
    "mode": "strict"
  },
  "telemetry": {
    "enabled": false
  }
}
