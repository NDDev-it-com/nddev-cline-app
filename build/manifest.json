{
  "schema_version": 2,
  "name": "nddev-cline-app",
  "build_version": "0.2.0",
  "entrypoint": "python3 cli-tools/nddev_cline.py",
  "source_root": "setups",
  "setup_ids": ["nddev-builder"],
  "profile_ids": ["full-auto", "safe"],
  "default_setup": "nddev-builder",
  "default_profile": "full-auto",
  "managed_files": [
    "home/.cline/data/settings/global-settings.json",
    "home/.cline/data/settings/cline_mcp_settings.json",
    "home/.cline/rules/nddev-managed.md",
    "home/.cline/skills/nddev-builder/SKILL.md",
    "home/.cline/skills/nddev-builder/references/agents.md",
    "home/.cline/skills/nddev-builder/references/hooks.md",
    "home/.cline/skills/nddev-builder/references/mcp.md",
    "home/.cline/skills/nddev-builder/references/native-paths.md",
    "home/.cline/skills/nddev-builder/references/plugins.md",
    "home/.cline/skills/nddev-builder/references/profiles-runtime.md",
    "home/.cline/skills/nddev-builder/references/rules-memory.md",
    "home/.cline/skills/nddev-builder/references/skills.md",
    "home/.cline/skills/nddev-builder/references/validation.md",
    "home/.cline/agents/nddev-builder.yaml",
    "home/.cline/plugins/nddev-builder/package.json",
    "home/.cline/plugins/nddev-builder/index.js",
    "NDDEV-CLINE-SETUP.json"
  ],
  "permission_policy": {
    "configuration_surface": "Cline CLI --auto-approve plus CLINE_COMMAND_PERMISSIONS JSON policy",
    "profiles": {
      "full-auto": {
        "default": true,
        "sandbox": false,
        "launch_args": ["--auto-approve", "true"],
        "command_permissions": {
          "allow": ["*"],
          "deny": [],
          "allowRedirects": true
        }
      },
      "safe": {
        "default": false,
        "sandbox": true,
        "launch_args": ["--plan", "--auto-approve", "false"],
        "command_permissions": {
          "allow": [],
          "deny": ["*"],
          "allowRedirects": false
        }
      }
    },
    "source": "profiles/<id>/profile.json and setup stamp"
  },
  "builder_capability": {
    "projection": "cline-native-skills-yaml-agent-plugin-rules-user-files",
    "source_root": "plugins/nddev-builder",
    "native_paths": ["skills", "agents", "plugins", "rules", "data/settings"],
    "default_on": true,
    "plugin_distribution": "native cline.plugins package in home/.cline/plugins"
  },
  "runtime_compatibility": {
    "baseline_ref": "references/cline-baseline.json",
    "version_ref": "build/version.json",
    "cli_tested_version": "3.0.46",
    "cli_package": "cline",
    "cli_command": "cline",
    "extension_tested_version": "4.0.11",
    "vscode_extension_id": "saoudrizwan.claude-dev",
    "supported_platforms": ["macos-arm64", "macos-x64", "ubuntu-linux-arm64", "ubuntu-linux-x64"],
    "unsupported_platforms": ["windows"]
  },
  "software_lifecycle": {
    "install_argv": [
      "npm",
      "install",
      "--global",
      "--prefix",
      "<stage-global>",
      "--cache",
      "<stage-cache>",
      "--userconfig",
      "<stage-npmrc>",
      "--globalconfig",
      "<stage-global-npmrc>",
      "--registry",
      "https://registry.npmjs.org/",
      "--fund=false",
      "--audit=false",
      "--ignore-scripts=false",
      "cline@3.0.46"
    ],
    "install_environment": "minimal-allowlist-target-owned-npm-global-prefix",
    "registry_metadata_preflight": "npm view cline@3.0.46 version/dist with pinned tarball, integrity, and shasum",
    "node_preflight": "Node.js 20+ required; 22 recommended",
    "status_validation": "manifest-tree-digest-no-exec",
    "install_precondition": "absent target-owned CLI software surface",
    "update_precondition": "installed or partial target-owned CLI software surface; absent fails without side effects",
    "absent_update_policy": "domain failure: Cline CLI is not installed; use install-cli; zero target or parent artifacts",
    "preflight_policy": "lstat-no-follow current-user-private target and parent before npm registry/install work",
    "transaction_directories": "unique private mkdtemp staging with transaction-owned rollback",
    "partial_state_policy": "install rejects any replace path or owned software parent; update may repair safe partial state",
    "current_idempotent": true,
    "version_probe": {
      "argv": ["bin/cline", "--version"],
      "environment": "native-minimal-isolated",
      "timeout_seconds": 60,
      "timeout_policy": "fail-closed-before-software-swap",
      "calibration_ref": "references/cline-baseline.json"
    },
    "bounds": {
      "max_tree_paths": 50000,
      "max_tree_bytes": 536870912
    },
    "layout": {
      "visible_command": "bin/cline",
      "global_dir": "software/cline-cli/install/global",
      "software_manifest": "software/cline-cli.json"
    }
  }
}
