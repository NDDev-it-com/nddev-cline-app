{
  "schema_version": 1,
  "product": "Cline",
  "cli": {
    "command": "cline",
    "package": "cline",
    "version": "3.0.47",
    "bin": {
      "cline": "bin/cline"
    },
    "node": {
      "minimum_major": 20,
      "recommended_major": 22,
      "official_install_docs": "Node.js 20+ required, 22 recommended",
      "workspace_package_engine": ">=22"
    },
    "version_probe": {
      "argv": ["cline", "--version"],
      "environment": "native-minimal-isolated",
      "fail_closed_before_software_swap": true
    }
  },
  "npm": {
    "package": "cline",
    "version": "3.0.47",
    "integrity": "sha512-3+RfBKRFk1s89FxYZJpM9t1dGLrpz/9WlP/zO9QP2U36C2A5ZvW7wbNKe8eFgYn52ihvKnT7wIel8KQz2vSf8Q==",
    "shasum": "e3c46aa1a6a8a0e52c2ab81b9d3b74f62b092f35",
    "tarball": "https://registry.npmjs.org/cline/-/cline-3.0.47.tgz",
    "scripts": {
      "postinstall": "node ./postinstall.mjs || true"
    },
    "optional_dependencies": {
      "@cline/cli-darwin-arm64": "3.0.47",
      "@cline/cli-darwin-x64": "3.0.47",
      "@cline/cli-linux-arm64": "3.0.47",
      "@cline/cli-linux-x64": "3.0.47",
      "@cline/cli-windows-arm64": "3.0.47",
      "@cline/cli-windows-x64": "3.0.47"
    }
  },
  "package_manager": {
    "name": "npm",
    "official_install_argv": ["npm", "install", "-g", "cline"],
    "managed_install_argv": [
      "npm",
      "ci",
      "--cache",
      "<stage-cache>",
      "--userconfig",
      "<stage-npmrc>",
      "--globalconfig",
      "<stage-global-npmrc>",
      "--registry",
      "https://registry.npmjs.org/",
      "--fund=false",
      "--audit=false",
      "--ignore-scripts=true",
      "--bin-links=false"
    ],
    "registry": "https://registry.npmjs.org/",
    "install_project_policy": "target-owned staged npm ci project only",
    "lockfile": "software/cline-cli/package-lock.json",
    "lockfile_sha256": "0fc2629ceabe085f38b08fc90609e2056beb5dea82adbf7a01b6e3d46251db73"
  },
  "extension": {
    "publisher": "saoudrizwan",
    "name": "claude-dev",
    "display_name": "Cline",
    "id": "saoudrizwan.claude-dev",
    "version": "4.0.12",
    "marketplace_url": "https://marketplace.visualstudio.com/items?itemName=saoudrizwan.claude-dev",
    "install_supported_by_manager": false,
    "launch_supported_by_manager": false
  },
  "native_surfaces": {
    "global_root": "~/.cline/",
    "cli_data_dir_flag": "--data-dir",
    "cli_config_flag": "--config",
    "cli_hooks_dir_flag": "--hooks-dir",
    "data_dir_env": "CLINE_DATA_DIR",
    "sandbox_env": "CLINE_SANDBOX",
    "command_permissions_env": "CLINE_COMMAND_PERMISSIONS",
    "global_settings": "data/settings/global-settings.json",
    "mcp_settings": "data/settings/cline_mcp_settings.json",
    "rules": "rules/",
    "skills": "skills/",
    "agents": "agents/",
    "agent_extensions": [".yaml", ".yml"],
    "plugins": "plugins/",
    "plugin_manifest": "package.json cline.plugins",
    "marketplace": null
  },
  "sources": [
    "https://docs.cline.bot/getting-started/installing-cline",
    "https://docs.cline.bot/cli/cli-reference",
    "https://docs.cline.bot/customization/skills",
    "https://docs.cline.bot/customization/plugins",
